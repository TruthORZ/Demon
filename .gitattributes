* text=auto

# Keep source and Unity serialized assets consistent across machines.
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.inputactions text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.uxml text eol=lf
*.uss text eol=lf

# Binary source asset declarations; large source formats use Git LFS below.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.pdf binary
*.docx binary

# Unity NavMeshData is native binary even with Force Text serialization.
Assets/Demon/Data/ChaseNavigation.asset binary
Assets/Demon/Data/ChasePracticeNavigation.asset binary

Assets/Demon/Data/RetrievalNavigation.asset binary

Assets/Demon/Data/ExplorationNavigation.asset binary

Assets/Demon/Data/InvestigationNavigation.asset binary
Assets/Demon/Data/SignalSearchNavigation.asset binary

