  Days:
  - Title: "\u503C\u5B88\u5F00\u59CB"
    Objective: "\u719F\u6089\u6E56\u5CB8\u3001\u7BB1\u5B50B\u4E0E\u5DE6\u4FA7\u7761\u888B\u3002\u7B2C\u4E00\u591C\u5F00\u5C01\u5370\u4ECD\u4E3A\u72B6\u6001\u5360\u4F4D\u3002"
    WakeHour: 8
  - Title: "\u53D1\u73B0\u9884\u544A"
    Objective: "\u53F3\u4FA7\u51FA\u73B0T01\uFF0C\u8BB0\u5F55\u7B2C\u4E09\u5929\u7684\u8FD0\u52A8\u8F6C\u79FB\u9884\u544A\u3002"
    WakeHour: 8
  - Title: "\u9884\u544A\u6210\u771F"
    Objective: "T01\u8FD0\u52A8\u65E5\u671F\u5DF2\u5230\uFF0C\u53D1\u73B0T02\u58F0\u97F3\u4EA4\u6362\u8BB0\u5F55\uFF1B\u5B9E\u9645\u80FD\u529B\u4E0E\u8FFD\u9010\u5C06\u5728\u540E\u7EED\u5236\u4F5C\u3002"
    WakeHour: 8
  - Title: "\u89C2\u5BDF\u4E0E\u63A8\u7406"
    Objective: "\u53F3\u4FA7\u51FA\u73B0T03\uFF0C\u8C03\u67E5\u5B83\u8BB0\u5F55\u7684\u7B2C\u4E03\u5929\u53D8\u5316\u3002"
    WakeHour: 8
  - Title: "\u58F0\u97F3\u7684\u5F02\u53D8"
    Objective: "T02\u58F0\u97F3\u65E5\u671F\u5DF2\u5230\uFF0C\u53D1\u73B0T04\uFF1A\u7B2C\u4E5D\u5929\u8D4B\u4E88\u5B9E\u4F53\u3002\u5B9E\u9645\u58F0\u97F3\u6548\u679C\u5F85\u63A5\u5165\u3002"
    WakeHour: 8
  - Title: "\u76D1\u542C\u5DE5\u5177"
    Objective: "\u641C\u5BFBT05\u76D1\u542C\u5DE5\u5177\u8BB0\u5F55\u3002\u65B0\u7248\u4E0D\u518D\u8DF3\u65E5\uFF1B\u98CE\u94C3\u8865\u5168\u4E0E\u533A\u57DF\u76D1\u542C\u5F85\u63A5\u5165\u3002"
    WakeHour: 8
  - Title: "\u6C38\u591C\u4E0E\u8FD0\u52A8\u4EA4\u6362"
    Objective: "T03\u5149\u65E5\u671F\u5DF2\u5230\uFF0C\u5B66\u4E60T06\u8FD0\u52A8\u4EA4\u6362\u4E0E\u5149\u675F\u7275\u5236\u3002\u5BC6\u7801\u7BB1A\u3001\u6C38\u591C\u548C\u624B\u7535\u64CD\u4F5C\u5F85\u63A5\u5165\u3002"
    WakeHour: 8
  - Title: "\u7B49\u5F85\u843D\u7A7A"
    Objective: "\u63A5\u73ED\u672A\u5230\u3002T07\u5C06\u572822:00\u5F00\u653E\uFF1B\u5F53\u524D\u53EF\u7761\u5230D9\uFF0C\u6216\u7B49\u5F85\u591C\u95F4\u4FEE\u590D\u5E76\u6253\u5F00B\u3002\u5FEB\u901F\u9A8C\u8BC1\u53EF\u7528DemonSlice\u573A\u666F\u3002"
    WakeHour: 8
  - Title: "\u7B2C\u4E5D\u5929"
    Objective: "\u7B2C\u4E5D\u5929\u3002"
    WakeHour: 8
  Tablets:
  - Title: "T01 \u77F3\u677F\u8BB0\u5F55"
    DiscoveryDay: 2
    DateNodeDay: 3
    Record: "\u3010T01 \xB7 \u5C01\u5370\u4E00 \xB7 \u5DF2\u56FA\u5316\u3011\nIF DAY == 3\nTRANSFER(MOTION, WIND_VANE, DEMON)\n\n\u7B2C\u4E09\u5929\u96F6\u70B9\uFF0C\u98CE\u5411\u6807\u7684\u8FD0\u52A8\u8F6C\u79FB\u7ED9\u6076\u9B54\u3002\n\u53D1\u73B0\u6216\u9605\u8BFB\u4E0D\u4F1A\u6FC0\u6D3B\u3001\u963B\u6B62\u65E2\u5B9A\u7A0B\u5E8F\u3002\n\n\u5F53\u524D\u7070\u76D2\u4EC5\u8BB0\u5F55\u8BED\u53E5\uFF0C\u5B9E\u9645\u8BBE\u65BD\u4E0E\u8FFD\u9010\u5F85\u5236\u4F5C\u3002"
  - Title: "T02 \u77F3\u677F\u8BB0\u5F55"
    DiscoveryDay: 3
    DateNodeDay: 5
    Record: "\u3010T02 \xB7 \u5C01\u5370\u4E8C \xB7 \u5DF2\u56FA\u5316\u3011\nIF DAY == 5\nEXCHANGE(SOUND, RADIO, DEMON)\n\n\u7B2C\u4E94\u5929\u96F6\u70B9\uFF0C\u7535\u53F0\u4E0E\u6076\u9B54\u4EA4\u6362\u58F0\u97F3\u3002\n\u4EA4\u6362\u4E24\u6B21\u4F1A\u6062\u590D\u539F\u72B6\u6001\u3002\n\n\u5B9E\u9645\u58F0\u97F3\u6F14\u51FA\u5F85\u5236\u4F5C\u3002"
  - Title: "T03 \u77F3\u677F\u8BB0\u5F55"
    DiscoveryDay: 4
    DateNodeDay: 7
    Record: "\u3010T03 \xB7 \u5C01\u5370\u4E09 \xB7 \u5DF2\u56FA\u5316\u3011\nIF DAY == 7\nTRANSFER(LIGHT, SUN, DEMON)\n\n\u7B2C\u4E03\u5929\u96F6\u70B9\uFF0C\u592A\u9633\u7684\u5149\u8F6C\u79FB\u7ED9\u6076\u9B54\u3002\n\u8BB0\u5F55\u5185\u5BB9\u4E3A\u8BBE\u8BA1\u8BF4\u660E\uFF0C\u6B63\u5F0F\u7B26\u6587\u4E0E\u6C38\u591C\u6F14\u51FA\u5F85\u5236\u4F5C\u3002"
  - Title: "T04 \u77F3\u677F\u8BB0\u5F55"
    DiscoveryDay: 5
    DateNodeDay: 9
    Record: "\u3010T04 \xB7 \u5C01\u5370\u56DB \xB7 \u5DF2\u56FA\u5316\u3011\nIF DAY == 9\n\n\u7B2C\u4E5D\u5929\u96F6\u70B9\uFF0C\u6295\u5F71\u83B7\u5F97\u5B9E\u4F53\u3002\n\u51FD\u6570\u7CBE\u786E\u7B7E\u540D\u4E0E\u5B9E\u4F53\u6765\u6E90\u5F85\u5B9A\uFF0C\u5F53\u524D\u89C4\u5219\u5DF2\u63A5\u5165\u8FD9\u4E00\u65E5\u671F\u72B6\u6001\u3002"
  - Title: "T05 \u77F3\u677F\u8BB0\u5F55"
    DiscoveryDay: 6
    DateNodeDay: 0
    Record: "\u3010T05 \xB7 \u76D1\u542C\u5DE5\u5177\u3011\n\u7B2C\u516D\u5929\u901A\u8FC7\u6B63\u5E38\u641C\u5BFB\u53D6\u5F97\uFF0C\u8865\u5168\u540E\u542F\u7528\u98CE\u94C3\uFF0C\u4E0D\u63A8\u8FDB\u65E5\u671F\u3002\n\n\u6076\u9B54\u8FDB\u5165\u76D1\u6D4B\u533A\u57DF\u54CD\u4E00\u6B21\uFF0C\u79BB\u5F00\u540E\u91CD\u65B0\u76D1\u542C\u3002\n\u6C89\u9ED8\u4E0D\u7B49\u4E8E\u5B89\u5168\u3002\n\n\u5F53\u524D\u53EA\u8BFB\u5360\u4F4D\uFF0C\u8865\u5168\u548C\u98CE\u94C3\u4EA4\u4E92\u5F85\u5236\u4F5C\u3002"
  - Title: "T06 \u77F3\u677F\u8BB0\u5F55"
    DiscoveryDay: 7
    DateNodeDay: 0
    Record: "\u3010T06 \xB7 \u8FD0\u52A8\u4EA4\u6362\u4E0E\u5149\u675F\u7275\u5236\u3011\n\u8BBE\u8BA1\u53D6\u5F97\u65B9\u5F0F\uFF1A\u7BB1\u5B50A\uFF0C\u7B26\u53F7\u4F9D\u6B21\u4E3A\u7535\u53F0\u3001\u592A\u9633\u3001\u98CE\u5411\u6807\uFF1B\u5BF9\u7167\u6570\u5B57\u8F6E\u76D8\u7684\u56FA\u5B9A\u65B9\u4F4D\u3002\n\n\u7A33\u5B9A\u7167\u5C04\uFF1A\u4EA4\u6362\u6076\u9B54\u4E0E\u98CE\u5411\u6807\u7684\u8FD0\u52A8\u3002\n\u5931\u53BB\u9501\u5B9A\uFF1A\u518D\u6B21\u4EA4\u6362\uFF0C\u6062\u590D\u3002\n\u8F6C\u8EAB\u3001\u906E\u6321\u6216\u8D85\u8DDD\u4F1A\u5931\u9501\uFF1B\u62FE\u53D6\u9700\u8981\u77ED\u6682\u79FB\u5F00\u5149\u675F\u3002\n\n\u5F53\u524D\u4EC5\u8BB0\u5F55\uFF0C\u5BC6\u7801\u7BB1\u548C\u624B\u7535\u4EA4\u4E92\u5F85\u5236\u4F5C\u3002"
  FirstNightOpeningHour: 22
  FinalTabletDay: 8
  FinalTabletHour: 22
  FirstNightMessage: "\u66B4\u98CE\u96EA\u4E2D\u7684\u6E56\u53D1\u751F\u4E86\u53D8\u5316\u3002\u5C01\u5370\u5DF2\u5F00\u542F\u3002\n\uFF08\u5F53\u524D\u4E3A\u6D41\u7A0B\u5360\u4F4D\uFF0C\u5C1A\u65E0\u90AA\u6559\u5F92\u6F14\u51FA\u3002\uFF09"
