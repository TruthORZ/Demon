  Radio:
    Title: "\u7535\u53F0\u89C2\u5BDF"
    Normal: "\u521A\u624D\u7535\u53F0\u6B63\u5728\u64AD\u653E\u56FA\u5B9A\u77ED\u65CB\u5F8B\uFF0C\u58F0\u97F3\u6765\u81EA\u7535\u53F0\u672C\u8EAB\u3002\u8BB0\u4F4F\u5B83\u7684\u8282\u594F\u4E0E\u4F4D\u7F6E\u3002"
    Changed: "\u7535\u53F0\u53EA\u5269\u9759\u7535\u5E95\u566A\u3002\u539F\u5148\u719F\u6089\u7684\u65CB\u5F8B\u4ECE\u6E56\u4E2D\u4F20\u6765\u3002"
    Special:
  WindVane:
    Title: "\u98CE\u5411\u6807\u89C2\u5BDF"
    Normal: "\u521A\u624D\u53F6\u7247\u6B63\u5728\u8F6C\u52A8\uFF0C\u98CE\u5411\u6807\u6839\u90E8\u7684\u4F4D\u7F6E\u56FA\u5B9A\u3002"
    Changed: "\u98CE\u4ECD\u7136\u5439\u7740\uFF0C\u53F6\u7247\u5374\u5DF2\u7ECF\u505C\u6B62\u3002\u56DE\u60F3\u77F3\u677F\u4E0A\u9884\u544A\u7684\u65E5\u671F\u3002"
    Special: "\u521A\u624D\u7A33\u5B9A\u7167\u5C04\u96EA\u75D5\u65F6\uFF0C\u53F6\u7247\u6062\u590D\u4E86\u8F6C\u52A8\u3002\u68C0\u67E5\u8BB0\u5F55\u4F1A\u4FDD\u7559\u5F53\u65F6\u7684\u89C2\u5BDF\uFF1B\u653E\u4E0B\u5149\u675F\u540E\u60C5\u51B5\u53EF\u80FD\u53D8\u5316\u3002"
  Lake:
    Title: "\u6E56\u5CB8\u89C2\u5BDF"
    Normal: "\u521A\u624D\u5C01\u5370\u6807\u8BB0\u5B8C\u6574\u3002\u6E56\u5CB8\u6CA1\u6709\u5BF9\u5916\u53D1\u51FA\u5F02\u5149\u3002\u6CBF\u5CB8\u89C2\u5BDF\uFF0C\u8BB0\u4F4F\u8FD9\u91CC\u7684\u6B63\u5E38\u72B6\u6001\u3002"
    Changed: "\u5C01\u5370\u5DF2\u7ECF\u5F00\u542F\uFF0C\u6E56\u9762\u4ECD\u7136\u660F\u6697\u3002\u89C2\u5BDF\u5230\u7684\u72B6\u6001\u4E0E\u65E5\u671F\u4E00\u8D77\u8BB0\u4E0B\u3002"
    Special: "\u6E56\u4E2D\u6301\u7EED\u53D1\u5149\uFF0C\u5373\u4F7F\u5230\u4E86\u9884\u671F\u65E5\u51FA\uFF0C\u8425\u5730\u4ECD\u662F\u591C\u8272\u3002"
  Day1Guide: "\u53EF\u9009\u503C\u5B88\u89C2\u5BDF\uFF1A\u68C0\u67E5\u7535\u53F0\u3001\u98CE\u5411\u6807\u4E0E\u6E56\u5CB8\u3002\u8BB0\u5F55\u4E0D\u9650\u5236\u7761\u89C9\u3002"
  Day2Guide: "\u5357\u4FA7\u5C0F\u811A\u5370\u901A\u5411\u6797\u4E2D\u5C71\u6D1E\u3002\u6CBF\u75D5\u8FF9\u5BFB\u627E T01\u3002"
  Day3Guide: "\u98CE\u5411\u6807\u5DF2\u505C\u6B62\u3002\u5357\u4FA7\u5C0F\u5F84\u5411\u897F\u5C94\u5F00\u7684\u5927\u96EA\u75D5\u901A\u5411 T02\uFF1B\u7559\u610F\u6B63\u5728\u63A5\u8FD1\u7684\u96EA\u96FE\u3002"
  Day3FoundGuide: "T02 \u9884\u544A D5 \u58F0\u97F3\u4EA4\u6362\u3002\u5927\u96EA\u75D5\u662F\u7559\u4E0B\u7684\u8DEF\u7EBF\uFF0C\u5F53\u524D\u5A01\u80C1\u4ECD\u4F1A\u79FB\u52A8\u3002\u53EF\u8FD4\u8425\u6574\u7406\u3002"
  Day4Guide: "\u8C03\u67E5\u5C71\u6D1E\u897F\u4FA7\u5916\u9762\u7684\u65E7\u4EEA\u5F0F\u9057\u5740\uFF0C\u5BFB\u627E T03\u3002\u641C\u5BFB\u4E0D\u9650\u5236\u7761\u89C9\u3002"
  Day4FoundGuide: "T03 \u9884\u544A D7 \u5149\u7684\u8F6C\u79FB\u3002\u5BF9\u7167\u5F53\u524D\u65E5\u5149\u4E0E\u7535\u53F0\uFF0C\u8BB0\u4F4F\u4E24\u6761\u65E5\u671F\u9884\u544A\u3002"
  Day5Guide: "\u7535\u53F0\u53EA\u5269\u9759\u7535\u3002\u5FAA\u6E56\u4E2D\u719F\u6089\u7684\u5E7F\u64AD\u5230\u6E56\u5CB8\uFF0C\u5BFB\u627E T04\u3002"
  Day5FoundGuide: "T04 \u9884\u544A D9 \u83B7\u5F97\u5B9E\u4F53\u3002\u5E7F\u64AD\u4ECD\u4ECE\u6E56\u4E2D\u4F20\u6765\uFF1B\u53EF\u8FD4\u8425\u6574\u7406\u6216\u7761\u89C9\u3002"
  Day6Guide: "\u6CBF\u5357\u4FA7\u6797\u5F84\u5411\u4E1C\uFF0C\u5BFB\u627E\u65E7\u76D1\u542C\u7AD9\u7684 T05 \u4E0E\u4E24\u53EA\u98CE\u94C3\u3002"
  Day6FoundGuide: "\u8865\u5168 T05\uFF1A\u4E2D\u5FC3 RING\u3001\u4E0B\u4E2D CHIME\uFF0C\u6309 Enter \u542F\u7528\u98CE\u94C3\u3002\u4E0D\u6539\u53D8\u65E5\u671F\u3002"
  Day6ActiveGuide: "\u98CE\u94C3\u5DF2\u542F\u7528\u3002\u5148\u5728\u6728\u5899\u5317\u4FA7\u770B\u96EA\u75D5\u7ECF\u8FC7\uFF0C\u518D\u7ED5\u5899\u542C\u9AD8\u4F4E\u97F3\u8FA8\u8BA4\u533A\u57DF\u3002\u6C89\u9ED8\u4E0D\u4EE3\u8868\u5B89\u5168\u3002"
  FoundGuide: "\u5DF2\u8BB0\u5F55 T01 \u7684\u9884\u544A\u3002\u53EF\u4EE5\u6CBF\u539F\u8DEF\u56DE\u8425\u5730\uFF0C\u4E5F\u53EF\u7EE7\u7EED\u63A2\u7D22\u3002"
