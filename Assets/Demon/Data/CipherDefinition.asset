  WheelInstructions: "\u8F6E\u76D8\u5317\u6807\u4E0E\u573A\u5730\u65B9\u5411\u4E00\u81F4\u3002\n\u89C2\u5BDF\u7535\u53F0\u3001\u592A\u9633\u3001\u98CE\u5411\u6807\u76F8\u5BF9\u8F6E\u76D8\u7684\u7269\u4F53\u4F4D\u7F6E\uFF0C\u5404\u5BF9\u5E94\u4E00\u4E2A\u6570\u5B57\u3002\n\u6309\u7BB1\u9762\u7B26\u53F7\u987A\u5E8F\u8F93\u5165\u3002\u98CE\u5411\u6807\u53F6\u7247\u7684\u6307\u5411\u4E0D\u53C2\u4E0E\u5BC6\u7801\u3002\nEsc \u653E\u4E0B\u8F6E\u76D8\u3002"
  LockInstructions: "\u7BB1\u5B50 A \xB7 \u4E09\u4F4D\u673A\u68B0\u9501\n\u987A\u5E8F\uFF1A\u7535\u53F0 \u2192 \u592A\u9633 \u2192 \u98CE\u5411\u6807\n\u70B9\u51FB\u6BCF\u4F4D\u6570\u5B57\u52A0\u4E00\uFF089\u540E\u56DE\u52300\uFF09\uFF0CEnter \u5C1D\u8BD5\uFF1BEsc \u8FD4\u56DE\uFF0C\u8F93\u5165\u4F1A\u4FDD\u7559\u3002"
  UnlockedText: "\u7BB1\u5B50 A \u5DF2\u6253\u5F00\u3002\u91CC\u9762\u662F T06\uFF0C\u9760\u8FD1\u6309 E \u53D6\u51FA\u3002"
