  Radio:
    Title: "\u7535\u53F0\u89C2\u5BDF"
    Normal: "\u521A\u624D\u7535\u53F0\u6B63\u5728\u64AD\u653E\u56FA\u5B9A\u77ED\u65CB\u5F8B\uFF0C\u58F0\u97F3\u6765\u81EA\u7535\u53F0\u672C\u8EAB\u3002\u8BB0\u4F4F\u5B83\u7684\u8282\u594F\u4E0E\u4F4D\u7F6E\u3002"
    Changed: "\u7535\u53F0\u53D1\u51FA\u523A\u8033\u5578\u53EB\uFF0C\u539F\u5148\u7684\u5E7F\u64AD\u5374\u4ECE\u6E56\u4E2D\u4F20\u6765\u3002"
    Special:
  WindVane:
    Title: "\u98CE\u5411\u6807\u89C2\u5BDF"
    Normal: "\u521A\u624D\u53F6\u7247\u6B63\u5728\u8F6C\u52A8\uFF0C\u98CE\u5411\u6807\u6839\u90E8\u7684\u4F4D\u7F6E\u56FA\u5B9A\u3002"
    Changed: "\u98CE\u4ECD\u7136\u5439\u7740\uFF0C\u53F6\u7247\u5374\u5DF2\u7ECF\u505C\u6B62\u3002\u56DE\u60F3\u77F3\u677F\u4E0A\u9884\u544A\u7684\u65E5\u671F\u3002"
    Special: "\u521A\u624D\u7A33\u5B9A\u7167\u5C04\u96EA\u75D5\u65F6\uFF0C\u53F6\u7247\u6062\u590D\u4E86\u8F6C\u52A8\u3002\u68C0\u67E5\u8BB0\u5F55\u4F1A\u4FDD\u7559\u5F53\u65F6\u7684\u89C2\u5BDF\uFF1B\u653E\u4E0B\u5149\u675F\u540E\u60C5\u51B5\u53EF\u80FD\u53D8\u5316\u3002"
  Lake:
    Title: "\u6E56\u5CB8\u89C2\u5BDF"
    Normal: "\u521A\u624D\u5C01\u5370\u6807\u8BB0\u5B8C\u6574\u3002\u6E56\u5CB8\u6CA1\u6709\u5BF9\u5916\u53D1\u51FA\u5F02\u5149\u3002\u6CBF\u5CB8\u89C2\u5BDF\uFF0C\u8BB0\u4F4F\u8FD9\u91CC\u7684\u6B63\u5E38\u72B6\u6001\u3002"
    Changed: "\u5C01\u5370\u5DF2\u7ECF\u5F00\u542F\uFF0C\u6E56\u9762\u4ECD\u7136\u660F\u6697\u3002\u89C2\u5BDF\u5230\u7684\u72B6\u6001\u4E0E\u65E5\u671F\u4E00\u8D77\u8BB0\u4E0B\u3002"
    Special: "\u6E56\u4E2D\u6301\u7EED\u53D1\u5149\uFF0C\u5373\u4F7F\u5230\u4E86\u9884\u671F\u65E5\u51FA\uFF0C\u8425\u5730\u4ECD\u662F\u591C\u8272\u3002"
  Day1Guide: "\u53EF\u9009\u503C\u5B88\u89C2\u5BDF\uFF1A\u68C0\u67E5\u7535\u53F0\u3001\u98CE\u5411\u6807\u4E0E\u6E56\u5CB8\u3002\u8BB0\u5F55\u4E0D\u9650\u5236\u7761\u89C9\u3002"
  Day2Guide: "\u5357\u4FA7\u5C0F\u811A\u5370\u901A\u5411\u6797\u4E2D\u5C71\u6D1E\u3002\u6CBF\u75D5\u8FF9\u5BFB\u627E T01\u3002"
  Day3Guide: "\u98CE\u5411\u6807\u5DF2\u7ECF\u505C\u8F6C\u3002\u51FA\u95E8\u6CBF\u56F4\u680F\u5185\u7684\u5927\u96EA\u75D5\u7ED5\u5230\u6728\u5C4B\u5317\u4FA7\u6797\u95F4\uFF0C\u5BFB\u627E T02\u3002\u7559\u610F\u4ECD\u5728\u79FB\u52A8\u7684\u96EA\u96FE\u3002"
  Day3FoundGuide: "T02 \u9884\u544A D5 \u58F0\u97F3\u4EA4\u6362\u3002\u5927\u96EA\u75D5\u662F\u7559\u4E0B\u7684\u8DEF\u7EBF\uFF0C\u5F53\u524D\u5A01\u80C1\u4ECD\u4F1A\u79FB\u52A8\u3002\u53EF\u8FD4\u8425\u6574\u7406\u3002"
  Day4Guide: "\u51FA\u95E8\u540E\u6CBF\u5357\u4FA7\u5C0F\u5F84\u5BFB\u627E\u65E7\u4EEA\u5F0F\u77F3\u67F1\u548C T03\uFF0C\u79BB\u5C71\u6D1E\u7684\u811A\u5370\u8DEF\u7EBF\u4E0D\u8FDC\u3002"
  Day4FoundGuide: "T03 \u9884\u544A D7 \u5149\u7684\u8F6C\u79FB\u3002\u5BF9\u7167\u5F53\u524D\u65E5\u5149\u4E0E\u7535\u53F0\uFF0C\u8BB0\u4F4F\u4E24\u6761\u65E5\u671F\u9884\u544A\u3002"
  Day5Guide: "\u7535\u53F0\u53EA\u5269\u9759\u7535\u3002\u4ECE\u98CE\u5411\u6807\u4E00\u4FA7\u7684\u56F4\u680F\u5F00\u53E3\u8D70\u5411\u6E56\u5CB8\uFF0C\u5FAA\u6E56\u4E2D\u5E7F\u64AD\u5BFB\u627E T04\u3002"
  Day5FoundGuide: "T04 \u9884\u544A D9 \u83B7\u5F97\u5B9E\u4F53\u3002\u5E7F\u64AD\u4ECD\u4ECE\u6E56\u4E2D\u4F20\u6765\uFF1B\u53EF\u8FD4\u8425\u6574\u7406\u6216\u7761\u89C9\u3002"
  Day6Guide: "\u4ECE\u98CE\u5411\u6807\u4E00\u4FA7\u7684\u56F4\u680F\u5F00\u53E3\u51FA\u53D1\uFF0C\u6CBF\u6E56\u5CB8\u5F80\u5317\uFF0C\u5230\u65E7\u76D1\u542C\u7AD9\u5BFB\u627E T05 \u548C\u4E24\u53EA\u98CE\u94C3\u3002"
  Day6FoundGuide: "\u8865\u5168 T05\uFF1A\u4E2D\u5FC3 RING\u3001\u4E0B\u4E2D CHIME\uFF0C\u6309 Enter \u542F\u7528\u98CE\u94C3\u3002\u4E0D\u6539\u53D8\u65E5\u671F\u3002"
  Day6ActiveGuide: "\u98CE\u94C3\u5DF2\u542F\u7528\u3002\u5148\u4ECE\u6728\u5899\u65C1\u89C2\u5BDF\u96EA\u75D5\u7ECF\u8FC7\uFF0C\u518D\u7ED5\u5230\u5899\u540E\u542C\u9AD8\u4F4E\u97F3\u3002\u6C89\u9ED8\u4E0D\u4EE3\u8868\u5B89\u5168\u3002"
  SolarRecord: "\u3010\u65E5\u51FA\u89C2\u5BDF\u3011\n\n\u5DF2\u7ECF\u8FC7\u4E86\u9884\u671F\u65E5\u51FA\uFF0C\u8425\u5730\u4ECD\u7136\u662F\u591C\u8272\u3002\u592A\u9633\u53EA\u5269\u9ED1\u5FC3\u4E0E\u767D\u8FB9\uFF0C\u6E56\u4E2D\u5374\u6301\u7EED\u53D1\u5149\u3002\n\u5BF9\u7167 T03\uFF1A\u8F6C\u79FB\u7684\u662F\u5149\uFF0C\u4E0D\u662F\u65F6\u95F4\u3002\u6302\u949F\u548C\u65E5\u671F\u4ECD\u5728\u7EE7\u7EED\u3002\n\n\u539F\u5148\u96BE\u4EE5\u8FA8\u8BA4\u7684\u7B26\u53F7\u4E0E\u592A\u9633\u8F6E\u5ED3\u4E00\u81F4\u3002\u56DE\u5230\u6728\u5C4B\uFF0C\u5BF9\u7167\u8F6E\u76D8\u4E0A\u7684\u7269\u4F53\u65B9\u4F4D\uFF0C\u68C0\u67E5\u7BB1\u5B50 A\u3002"
  HandoverRecord: "\u3010\u7B2C\u516B\u5929 \xB7 \u503C\u5B88\u4EA4\u63A5\u8BB0\u5F55\u3011\n\n\u539F\u5B9A\u4ECA\u5929\u4EA4\u73ED\u3002\u622A\u81F3\u5F53\u524D\u8BB0\u5F55\u65F6\u523B\uFF0C\u4ECD\u672A\u89C1\u63A5\u73ED\u4EBA\u5458\u5230\u8FBE\u3002\u7F3A\u5E2D\u539F\u56E0\u672A\u8BB0\u5F55\u3002\n\u6302\u949F\u4ECD\u5728\u8D70\uFF0C\u5929\u8272\u4E0D\u80FD\u518D\u7528\u6765\u5224\u65AD\u65F6\u523B\u3002\n\n\u4EA4\u73ED\u524D\u91CD\u65B0\u6838\u5BF9\uFF1A\nT04 \u8BB0\u8F7D\u7684\u7B2C\u4E5D\u5929\u65E5\u671F\uFF1B\n\u7BB1\u5B50 A \u4E2D\u7559\u4E0B\u7684\u8FD0\u52A8\u4EA4\u6362\u5DE5\u5177\uFF1B\n\u6797\u95F4\u98CE\u94C3\u63D0\u4F9B\u7684\u533A\u57DF\u9884\u8B66\u3002\n\n\u6700\u540E\u4E00\u5757\u5C01\u5370\u77F3\u677F\u4ECD\u5F85\u53D6\u56DE\u3002\u6574\u7406\u5DF2\u6709\u7EBF\u7D22\u4E0E\u5DE5\u5177\uFF0C\u591C\u95F4\u518D\u68C0\u67E5\u6E56\u5CB8\u3002\n\n\u67E5\u770B\u540E\u56DE\u5230\u5C4B\u5185\uFF0C\u6309T\u6216\u70B9\u51FB\u7B49\u5F85\u6309\u94AE\u8FDB\u5165\u591C\u95F4\u3002"
  Day7Guide: "\u9884\u671F\u65E5\u51FA\u5DF2\u7ECF\u8FC7\u53BB\uFF0C\u4ECD\u7136\u6CA1\u6709\u65E5\u5149\u3002\u67E5\u770B\u6728\u5C4B\u5185\u9760\u7535\u53F0\u4E00\u4FA7\u7684\u65E5\u51FA\u89C2\u5BDF\u8BB0\u5F55\u3002"
  Day7CipherGuide: "\u592A\u9633\u8F6E\u5ED3\u4E0E\u7BB1\u9762\u7B26\u53F7\u5BF9\u5E94\u3002\u5BF9\u7167\u8F6E\u76D8\u4E0A\u7684\u7535\u53F0\u3001\u592A\u9633\u3001\u98CE\u5411\u6807\u65B9\u4F4D\uFF0C\u89E3\u5F00 A \u540E\u518D\u6309 E \u53D6\u51FA T06\u3002"
  Day7BeamGuide: "\u5230\u6728\u5C4B\u5916\u98CE\u5411\u6807\u9644\u8FD1\uFF0C\u70B9\u51FB\u5DE6\u952E\u6253\u5F00\u624B\u7535\u5E76\u7A33\u5B9A\u7167\u4F4F\u79FB\u52A8\u7684\u96EA\u75D5\uFF1B\u89C2\u5BDF\u98CE\u5411\u6807\u8F6C\u52A8\uFF0C\u518D\u5173\u95ED\u624B\u7535\u9A8C\u8BC1\u6062\u590D\u3002"
  Day7LockedGuide: "\u8FD0\u52A8\u5DF2\u4EA4\u6362\uFF1A\u96EA\u75D5\u505C\u6B62\uFF0C\u98CE\u5411\u6807\u8F6C\u52A8\u3002\u518D\u6B21\u70B9\u51FB\u5DE6\u952E\u5173\u95ED\u624B\u7535\u6216\u79FB\u5F00\u5149\u675F\uFF0C\u89C2\u5BDF\u8FD0\u52A8\u6062\u590D\u3002"
  Day7ReadyGuide: "\u5DF2\u7ECF\u9A8C\u8BC1\u9501\u5B9A\u4E0E\u6062\u590D\u3002\u98CE\u94C3\u5224\u65AD\u533A\u57DF\uFF0C\u5149\u675F\u4E89\u53D6\u884C\u52A8\u65F6\u95F4\uFF1B\u53EF\u4EE5\u7EE7\u7EED\u719F\u6089\u8DEF\u7EBF\u6216\u7761\u5230\u6B21\u65E5\u3002"
  Day8Guide: "\u539F\u5B9A\u4ECA\u5929\u4EA4\u73ED\u3002\u67E5\u770B\u6728\u5C4B\u9760\u95E8\u4E00\u4FA7\u7684\u4EA4\u63A5\u53F0\uFF1B\u591C\u8272\u4E2D\u7684\u65F6\u523B\u4EE5\u6302\u949F\u4E3A\u51C6\u3002"
  Day8ToolGuide: "\u63A5\u73ED\u8005\u4ECD\u672A\u5230\u3002\u53EF\u5BF9\u7167\u8F6E\u76D8\u89E3\u5F00\u7BB1\u5B50 A\u3001\u53D6\u51FA T06\uFF0C\u518D\u719F\u6089\u53BB\u6E56\u5CB8\u7684\u8DEF\u7EBF\uFF1B\u51C6\u5907\u4E0E\u9605\u8BFB\u5747\u4E3A\u53EF\u9009\u3002"
  Day8ListeningGuide: "T06 \u5DF2\u53D6\u5F97\u3002\u53EF\u5230\u5317\u5CB8\u7684\u65E7\u76D1\u542C\u7AD9\u8865\u5168 T05\uFF0C\u53D6\u5F97\u533A\u57DF\u9884\u8B66\uFF1B\u5DF2\u5B8C\u6210\u7684\u5DE5\u5177\u4F1A\u4E00\u76F4\u4FDD\u7559\uFF0C\u4E5F\u53EF\u76F4\u63A5\u7B49\u5F85\u591C\u95F4\u6216\u7761\u89C9\u3002"
  Day8ReadyGuide: "\u4EA4\u63A5\u8BB0\u5F55\u5DF2\u6838\u5BF9\u3002T07 \u5728 {hour} \u540E\u53EF\u5230\u6E56\u5CB8\u5BFB\u627E\uFF1B\u98CE\u94C3\u5224\u65AD\u533A\u57DF\uFF0C\u5149\u675F\u4E89\u53D6\u65F6\u95F4\uFF0C\u53D6\u56DE\u540E\u5E26\u5230\u6728\u5C4B\u5185\u7684\u7A7A\u53F0\u3002\u4E5F\u53EF\u76F4\u63A5\u7761\u89C9\u3002"
  FoundGuide: "\u5DF2\u8BB0\u5F55 T01 \u7684\u9884\u544A\u3002\u53EF\u4EE5\u6CBF\u539F\u8DEF\u56DE\u8425\u5730\uFF0C\u4E5F\u53EF\u7EE7\u7EED\u63A2\u7D22\u3002"
