  Days:
  - Title: "\u503C\u5B88\u5F00\u59CB"
    Objective: "\u8FDB\u5165\u6728\u5C4B\u9605\u8BFB\u503C\u5B88\u987B\u77E5\uFF0C\u68C0\u67E5\u5C4B\u540E\u4E24\u4E2A\u7BB1\u5B50\u4E0E\u56DB\u5904\u5DE1\u67E5\u70B9\u3002\u5B8C\u6210\u5173\u952E\u4E8B\u9879\u5E76\u5165\u591C\u540E\u4F11\u606F\u3002"
    WakeHour: 8
  - Title: "\u53D1\u73B0\u9884\u544A"
    Objective: "\u5B8C\u6210\u56DB\u5904\u5DE1\u67E5\uFF0C\u6CBF\u4EBA\u7C7B\u811A\u5370\u524D\u5F80\u5C71\u6D1E\uFF0C\u5BFB\u627ET01\u3002"
    WakeHour: 8
  - Title: "\u9884\u544A\u6210\u771F"
    Objective: "\u5B8C\u6210\u56DB\u5904\u5DE1\u67E5\u3002\u98CE\u5411\u6807\u5DF2\u7ECF\u505C\u8F6C\uFF0C\u6CBF\u5927\u578B\u96EA\u75D5\u5BFB\u627E\u6797\u95F4T02\uFF0C\u7559\u610F\u903C\u8FD1\u7684\u96EA\u96FE\u3002"
    WakeHour: 8
  - Title: "\u89C2\u5BDF\u4E0E\u63A8\u7406"
    Objective: "\u5B8C\u6210\u56DB\u5904\u5DE1\u67E5\uFF0C\u524D\u5F80\u65E7\u4EEA\u5F0F\u9057\u8FF9\u5BFB\u627ET03\u3002"
    WakeHour: 8
  - Title: "\u58F0\u97F3\u7684\u5F02\u53D8"
    Objective: "\u5B8C\u6210\u56DB\u5904\u5DE1\u67E5\u3002\u7535\u53F0\u53D1\u51FA\u5578\u53EB\uFF0C\u5FAA\u6E56\u4E2D\u539F\u5E7F\u64AD\u5BFB\u627ET04\u3002"
    WakeHour: 8
  - Title: "\u98CE\u94C3\u76D1\u542C"
    Objective: "\u5B8C\u6210\u56DB\u5904\u5DE1\u67E5\uFF0C\u5230\u65E7\u76D1\u542C\u7AD9\u5BFB\u627E\u5E76\u8865\u5168T05\uFF0C\u542F\u7528\u98CE\u94C3\u3002"
    WakeHour: 8
  - Title: "\u6C38\u591C\u4E0E\u8FD0\u52A8\u4EA4\u6362"
    Objective: "\u5B8C\u6210\u56DB\u5904\u5DE1\u67E5\uFF0C\u89E3\u5F00\u7BB1A\u5E76\u53D6\u5F97T06\u3002\u5DF2\u63D0\u524D\u53D6\u5F97\u7684\u5DE5\u5177\u7EE7\u7EED\u4FDD\u7559\u3002"
    WakeHour: 8
  - Title: "\u7B49\u5F85\u843D\u7A7A"
    Objective: "\u68C0\u67E5\u4EA4\u63A5\u8BB0\u5F55\uFF0C\u5728\u5C4B\u5185\u6309T\u7B49\u5F85\u591C\u95F4\u3002\u53D6\u5F97T07\uFF0C\u5E26\u56DE\u8865\u5168\u5E76\u67E5\u770B\u7BB1B\u8BB0\u5F55\u3002"
    WakeHour: 8
  - Title: "\u7B2C\u4E5D\u5929"
    Objective: "\u7B2C\u4E5D\u5929\uFF0C\u6076\u9B54\u964D\u4E34\u3002"
    WakeHour: 8
  Tablets:
  - Title: "T01 \u77F3\u677F\u8BB0\u5F55"
    DiscoveryDay: 2
    DateNodeDay: 3
    Record: "\u3010T01 \xB7 \u5C01\u5370\u4E00 \xB7 \u5DF2\u56FA\u5316\u3011\nIF DAY == 3\nTRANSFER(MOTION, WIND_VANE, DEMON)\n\n\u7B2C\u4E09\u5929\u96F6\u70B9\uFF0C\u98CE\u5411\u6807\u7684\u8FD0\u52A8\u8F6C\u79FB\u7ED9\u6076\u9B54\u3002\n\u53D1\u73B0\u6216\u9605\u8BFB\u4E0D\u4F1A\u6FC0\u6D3B\u3001\u963B\u6B62\u65E2\u5B9A\u7A0B\u5E8F\u3002\n\n\u82E5\u98CE\u5411\u6807\u505C\u6B62\u800C\u96EA\u75D5\u5F00\u59CB\u79FB\u52A8\uFF0C\u8BF4\u660E\u8FD0\u52A8\u5DF2\u7ECF\u8F6C\u79FB\u3002"
  - Title: "T02 \u77F3\u677F\u8BB0\u5F55"
    DiscoveryDay: 3
    DateNodeDay: 5
    Record: "\u3010T02 \xB7 \u5DF2\u56FA\u5316\u3011\nIF DAY == 5\nEXCHANGE(SOUND, RADIO, DEMON)\n\n\u7B2C\u4E94\u65E5\u96F6\u70B9\uFF0C\u539F\u5E7F\u64AD\u4ECE\u7535\u53F0\u8F6C\u79FB\u5230\u6E56\u4E2D\u58F0\u6E90\uFF0C\u7535\u53F0\u53D1\u51FA\u5578\u53EB\u3002\u53D1\u73B0\u6216\u9605\u8BFB\u4E0D\u4F1A\u6539\u53D8\u65E2\u5B9A\u65E5\u671F\u7A0B\u5E8F\u3002"
  - Title: "T03 \u77F3\u677F\u8BB0\u5F55"
    DiscoveryDay: 4
    DateNodeDay: 7
    Record: "\u3010T03 \xB7 \u5DF2\u56FA\u5316\u3011\nIF DAY == 7\nTRANSFER(LIGHT, SUN, DEMON)\n\n\u7B2C7\u5929\u96F6\u70B9\uFF0C\u592A\u9633\u5931\u53BB\u7167\u660E\uFF0C\u6E56\u4E2D\u6076\u9B54\u83B7\u5F97\u5149\u3002\u5230\u9884\u671F\u65E5\u51FA\u65F6\uFF0C\u65E5\u8F6E\u53EA\u5269\u767D\u8FB9\uFF0C\u4E16\u754C\u6CA1\u6709\u6B63\u5E38\u65E5\u5149\u3002\n\n\u6B8B\u8FB9\u4E0E\u7B26\u6587\u63D0\u793A\u5149\u4E0D\u63D0\u4F9B\u592A\u9633\u7167\u660E\u3002\u65E5\u671F\u81EA\u52A8\u751F\u6548\uFF0C\u4E0D\u4F9D\u8D56\u662F\u5426\u9605\u8BFB\u3002"
  - Title: "T04 \u77F3\u677F\u8BB0\u5F55"
    DiscoveryDay: 5
    DateNodeDay: 9
    Record: "\u3010T04 \xB7 \u5C01\u5370\u56DB \xB7 \u5DF2\u56FA\u5316\u3011\nIF DAY == 9\n\n\u7B2C\u4E5D\u5929\u96F6\u70B9\uFF0C\u6E56\u4E2D\u7684\u6295\u5F71\u5C06\u83B7\u5F97\u5B9E\u4F53\u3002\n\n\u8FB9\u7F18\u6B8B\u7F3A\uFF0C\u5B9E\u4F53\u6765\u81EA\u4F55\u5904\u5DF2\u65E0\u6CD5\u8FA8\u8BA4\u3002\u65E5\u671F\u523B\u75D5\u4ECD\u7136\u6E05\u6670\u3002\n\u53D1\u73B0\u6216\u653E\u4E0B\u8FD9\u5757\u77F3\u677F\uFF0C\u4E0D\u4F1A\u6539\u53D8\u5B83\u9884\u544A\u7684\u65F6\u523B\u3002"
  - Title: "T05 \u77F3\u677F\u8BB0\u5F55"
    DiscoveryDay: 6
    DateNodeDay: 0
    Record: "\u3010T05 \xB7 \u524D\u4EBA\u76D1\u542C\u5DE5\u5177\u3011\n\u8865\u5168\u5373\u542F\u7528\u98CE\u94C3\uFF0C\u4E0D\u6539\u53D8\u65E5\u671F\u3002\n\u6076\u9B54\u8FDB\u5165\u533A\u57DF\u65F6\u62A5\u8B66\u4E00\u6B21\uFF0C\u79BB\u5F00\u540E\u91CD\u65B0\u5F85\u547D\u3002\u505C\u5728\u533A\u57DF\u5185\u4E0D\u91CD\u590D\u62A5\u8B66\u3002\n\u4E0D\u540C\u4F4D\u7F6E\u4E0E\u97F3\u8272\u63D0\u793A\u533A\u57DF\uFF1B\u54CD\u5EA6\u53D6\u51B3\u4E8E\u73A9\u5BB6\u79BB\u98CE\u94C3\u7684\u8DDD\u79BB\uFF0C\u6C89\u9ED8\u4E0D\u4EE3\u8868\u5B89\u5168\u3002"
  - Title: "T06 \u77F3\u677F\u8BB0\u5F55"
    DiscoveryDay: 7
    DateNodeDay: 0
    Record: "\u3010T06 \xB7 \u5DF2\u56FA\u5316\u8FD0\u52A8\u4EA4\u6362\u5DE5\u5177\u3011\n\u7A33\u5B9A\u5149\u675F\u9501\u5B9A\u96EA\u75D5\u533A\u57DF\u65F6\uFF0C\u4EA4\u6362\u6076\u9B54\u4E0E\u98CE\u5411\u6807\u7684\u8FD0\u52A8\uFF1B\u5931\u9501\u518D\u4EA4\u6362\u4E00\u6B21\u590D\u4F4D\u3002\n\u811A\u5370\u505C\u6B62\u65F6\u98CE\u5411\u6807\u8F6C\u52A8\uFF1B\u79FB\u5F00\u5149\u675F\u540E\u6062\u590D\u3002\n\n\u70B9\u51FB\u5DE6\u952E\u6253\u5F00\u624B\u7535\u5E76\u7167\u4F4F\u96EA\u75D5\uFF0C\u4FDD\u6301\u5230\u7A33\u5B9A\u3002\u8F6C\u8EAB\u3001\u906E\u6321\u3001\u8D85\u8DDD\u6216\u8FDB\u5165\u8FD1\u666F\u4F1A\u5931\u9501\u3002\n\u6E56\u5CB8\u89C2\u5BDF\u70B9\u80FD\u540C\u65F6\u89C2\u5BDF\u96EA\u75D5\u4E0E\u98CE\u5411\u6807\u3002\u98CE\u94C3\u8D1F\u8D23\u533A\u57DF\u9884\u8B66\uFF0C\u5149\u675F\u4E89\u53D6\u884C\u52A8\u65F6\u95F4\u3002"
  FirstNightOpeningHour: 22
  FinalTabletDay: 8
  FinalTabletHour: 22
  FirstNightMessage: "\u66B4\u98CE\u96EA\u4E2D\u7684\u6E56\u53D1\u751F\u4E86\u53D8\u5316\u3002\u5C01\u5370\u5DF2\u5F00\u542F\u3002\n\uFF08\u5F53\u524D\u4E3A\u6D41\u7A0B\u5360\u4F4D\uFF0C\u5C1A\u65E0\u90AA\u6559\u5F92\u6F14\u51FA\u3002\uFF09"
